# EvoNash Environment Configuration
# Copy this file to .env and update the values

# PostgreSQL Database Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://evonash:your_secure_password@localhost:5432/evonash

# API Secret Key (protects destructive endpoints like delete-all)
# Generate a random key: openssl rand -hex 32
# Workers must send this via Authorization: Bearer <key>
API_SECRET_KEY=

# Node.js Environment
NODE_ENV=production

# Server Port
PORT=3000
